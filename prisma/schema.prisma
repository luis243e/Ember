// =============================================================================
//  schema.prisma: el "plano" de tu base de datos.
//  Aquí describes tus tablas (models), sus columnas y cómo se relacionan.
//  Prisma lee este archivo para:
//    1) crear/modificar las tablas reales en Postgres (migraciones), y
//    2) generar un cliente TypeScript con autocompletado para usarlas.
//  Los comentarios con "//" son ignorados por Prisma; son solo para ti.
// =============================================================================


// -----------------------------------------------------------------------------
//  GENERATOR: qué código genera Prisma a partir de este archivo.
// -----------------------------------------------------------------------------
generator client {
  // "prisma-client-js" genera el cliente clásico de JavaScript/TypeScript.
  // En tu código lo importarás así: import { PrismaClient } from "@prisma/client"
  provider = "prisma-client-js"
}


// -----------------------------------------------------------------------------
//  DATASOURCE: a qué base de datos se conecta Prisma.
// -----------------------------------------------------------------------------
datasource db {
  // Tipo de base de datos: PostgreSQL (la que usa Supabase).
  provider  = "postgresql"

  // URL principal (pooler, puerto 6543). env("...") significa:
  // "lee este valor del archivo .env", así la contraseña no queda en el código.
  url       = env("DATABASE_URL")

  // URL directa (puerto 5432). Prisma la usa SOLO para migraciones,
  // porque el pooler no soporta bien los cambios de estructura de tablas.
  directUrl = env("DIRECT_URL")
}


// -----------------------------------------------------------------------------
//  ENUMS: listas cerradas de valores permitidos.
//  Si una columna es de tipo enum, la base de datos rechaza cualquier otro valor.
// -----------------------------------------------------------------------------

// Dificultad de una tarea (jefe).
enum Difficulty {
  EASY    // fácil
  MEDIUM  // media
  HARD    // difícil
}

// Estado del combate contra una tarea (jefe).
enum TaskStatus {
  ALIVE     // la tarea sigue pendiente: el jefe sigue en pie
  DEFEATED  // la completaste a tiempo: derrotaste al jefe
  FAILED    // pasó la fecha de entrega sin terminarla: el jefe te derrotó
}

// Estado de una misión de redención (reglas en lib/game.ts y lib/redemption.ts).
enum RedemptionStatus {
  ACTIVE     // en curso: las almas esperan donde caíste
  COMPLETED  // cumplida a tiempo: las almas volvieron
  EXPIRED    // se agotó el plazo: las almas se perdieron
  LOST       // volviste a caer antes de cumplirla: las almas se perdieron
}

// Tipo de una pregunta del banco (reglas en lib/questions/validation.ts).
enum QuestionType {
  MULTIPLE_CHOICE  // opción múltiple: exactamente 4 opciones
  TRUE_FALSE       // verdadero o falso: opciones fijas ["Verdadero", "Falso"]
}

// Quién escribió la pregunta. Lo pone SIEMPRE el servidor, nunca el formulario.
enum QuestionSource {
  MANUAL  // el usuario, a mano, en /materias/[id]
  AGENT   // el escriba, desde los apuntes (lib/agent/invocation.ts)
}

// Cómo terminó una invocación del escriba (reglas en lib/agent/rules.ts).
enum AgentInvocationStatus {
  PENDING  // reservada: el escriba está leyendo. Más de 5 minutos así = fallida
  OK       // escribió preguntas: cuenta para el límite diario
  FAILED   // falló (Gemini, el PDF, el máximo de la materia): no cuenta
}

// Qué le dio el usuario al escriba. Solo el tipo: los apuntes no se guardan.
enum AgentInputKind {
  TEXT       // texto pegado
  PDF        // un PDF subido
  REINFORCE  // refuerzo: preguntas falladas del banco (elegidas por el servidor)
}

// Cómo se cumple una misión de redención. Se fija al caer y no cambia
// (reglas en lib/game.ts, REDEMPTION y advanceRedemption).
enum RedemptionRule {
  LEGACY         // regla de antes de la Fase 3: 2 vigilias. Es el valor por
                 // defecto: así las misiones que ya existían (y las que cree
                 // el código viejo durante un despliegue) siguen con ella
  FEW_QUESTIONS  // la materia del jefe tenía menos de 5 preguntas: 2 vigilias
  TRIAL          // cada vigilia da un intento de la prueba de redención
}

// Las bendiciones: recompensas temporales que se eligen al vencer a un jefe
// (BLESSINGS en lib/game.ts, con su rareza, sus usos y su efecto). Ninguna
// acorta la vigilia, quita vida al jefe ni da golpes.
enum BlessingKey {
  SOULS            // común: +25 % de almas en los próximos 3 golpes
  ASH_SHIELD       // común: 2 respuestas falladas del contraataque no restan
  LUCIDITY         // común: en el próximo contraataque, +5 almas por acierto
  EMBER_SPARK      // rara: +1 brasa al elegirla (se aplica y no queda activa)
  SCRIBE_EYE       // rara: en el próximo contraataque, una opción incorrecta tachada
  REDEMPTION_SEAL  // épica: la próxima prueba de redención se aprueba con 3 de 5
}

// Estado de una relación entre compañeros (lib/friends.ts).
enum FriendshipStatus {
  PENDING   // solicitud enviada, sin contestar
  ACCEPTED  // compañeros
  DECLINED  // rechazada: la fila se queda como lápida (ver Friendship)
}


// -----------------------------------------------------------------------------
//  MODELOS: cada "model" se convierte en una TABLA de Postgres.
//  Cada línea dentro es una COLUMNA con la forma:  nombre  Tipo  @atributos
// -----------------------------------------------------------------------------

// ========== USUARIO (y su personaje) ==========
model User {
  // Identificador único de la fila.
  //   String     → se guarda como texto.
  //   @id        → esta columna es la clave primaria (identifica cada fila).
  //   @default(cuid()) → si no das un id, Prisma genera uno aleatorio único
  //                      (algo como "clx9k2...").
  id           String   @id @default(cuid())

  // @unique → la base de datos impide que dos usuarios tengan el mismo email.
  email        String   @unique

  // Nombre visible del usuario.
  name         String

  // ¿Confirmó su correo? Better Auth lo pone en true cuando el usuario
  // abre el enlace de verificación. Sin verificar no se puede entrar
  // (requireEmailVerification en lib/auth.ts y requireUser()).
  emailVerified Boolean @default(false)

  // URL de la foto de perfil. El "?" significa OPCIONAL (puede ser null).
  // La rellenará Google cuando añadamos ese inicio de sesión.
  image        String?

  // OJO: aquí ya NO hay contraseña. Better Auth guarda el hash de la
  // contraseña en la tabla Account (columna "password"), porque una persona
  // puede tener varias formas de entrar (correo, Google...).

  // Fecha de creación. @default(now()) pone la fecha/hora actual al crear la fila.
  createdAt    DateTime @default(now())

  // Fecha de la última modificación. @updatedAt hace que Prisma la
  // actualice sola cada vez que cambia la fila.
  updatedAt    DateTime @updatedAt

  // --- Campos del personaje ---
  // Better Auth los conoce como "additionalFields" (ver lib/auth.ts), con
  // input: false para que nadie pueda fijarlos desde el navegador.
  // Nivel del personaje. Int = número entero. Todos empiezan en nivel 1.
  level        Int      @default(1)

  // "Almas": la experiencia acumulada. Empieza en 0.
  souls        Int      @default(0)

  // "Llama": la racha de días seguidos estudiando. Empieza en 0.
  flame        Int      @default(0)

  // Día del último golpe asestado, como las fechas de entrega: el día de
  // Colombia guardado a las 00:00 UTC. Con él se sabe si la llama sigue
  // encendida (reglas en lib/game.ts). null = nunca ha golpeado.
  lastStrikeDay DateTime?

  // "Brasas": comodines que salvan la llama si un día no se golpea. De 0 a 2
  // (EMBER en lib/game.ts; un CHECK de la migración 20261014194417_brasa
  // impide salirse). Se ganan al terminar un contraataque perfecto contra un
  // jefe medio o difícil y se gastan solas al golpear (lib/battle.ts).
  embers       Int      @default(0)

  // --- Límite de correos de acceso (lib/auth-emails.ts) ---
  // Último correo enviado a esta cuenta (verificación o "ya tienes una
  // cuenta"). null = nunca. Como mucho uno por minuto.
  lastAuthEmailAt DateTime?

  // Correos enviados desde que empezó la ventana de 24 h actual. Como mucho
  // 5; vuelve a 1 cuando pasan 24 h desde el último.
  authEmailCount Int @default(0)

  // --- Perfil, recompensas y compañeros (Fase 4) ---
  // La racha más larga. Se actualiza al golpear (lib/battle.ts), con el
  // usuario bloqueado. La migración 20261019*_fase4 la rellenó con una COTA
  // INFERIOR (la llama guardada o los días seguidos con golpe): las brasas de
  // antes no dejaron rastro. Un CHECK de esa migración impide que sea < 0.
  bestFlame    Int      @default(0)

  // La reliquia equipada como título (la clave de RELICS en lib/game.ts), o
  // null. Solo se puede equipar una que se tenga (lib/rewards.ts).
  equippedRelic String?

  // Código de amigo: 8 caracteres del alfabeto FRIEND_CODE (lib/friends.ts).
  // Opcional para que el código que sigue desplegado durante una migración
  // pueda crear usuarios sin él; los nuevos lo reciben al crearse
  // (lib/auth.ts) y, si faltara, al abrir /companeros. Un CHECK de la
  // migración comprueba el formato.
  friendCode   String?  @unique

  // ¿Ven los compañeros el título, el nivel, la llama y los golpes? Si no,
  // solo el nombre (y no sale en su clasificación).
  showStats    Boolean  @default(true)

  // Solicitudes de compañero intentadas HOY (día de Colombia, guardado a las
  // 00:00 UTC como lastStrikeDay). Cuentan todos los intentos con un código
  // bien formado, exista o no: así el límite frena también el barrido de
  // códigos. Un contador y no las filas: cancelar no lo devuelve.
  friendRequestDay   DateTime?
  friendRequestCount Int     @default(0)

  // --- Relación ---
  // Un usuario tiene MUCHAS materias. "Subject[]" (con corchetes) = lista.
  // OJO: esta línea NO crea una columna en la tabla; es un "atajo" para que
  // Prisma te deje pedir "el usuario con sus materias" en una sola consulta.
  subjects     Subject[]

  // Sesiones abiertas y formas de entrar del usuario (tablas de Better Auth).
  sessions     Session[]
  accounts     Account[]

  // Vigilias (sesiones de estudio) del usuario, de todos sus jefes.
  studySessions StudySession[]

  // Misiones de redención del usuario: la activa (como mucho una) y las ya
  // resueltas, que se guardan para los avisos y como historial.
  redemptionMissions RedemptionMission[]

  // Respuestas del usuario a las preguntas de los contraataques.
  questionAttempts QuestionAttempt[]

  // Contraataques del usuario: como mucho uno por vigilia.
  counterattacks Counterattack[]

  // Invocaciones del escriba: con ellas se cuenta el límite diario.
  agentInvocations AgentInvocation[]

  // Pruebas de redención que ha afrontado.
  redemptionTrials RedemptionTrial[]

  // Recompensas: las bendiciones activas, las ofertas de bendición y las
  // reliquias conseguidas.
  blessings      Blessing[]
  blessingOffers BlessingOffer[]
  relics         Relic[]

  // Compañeros: las solicitudes que envió y las que recibió (aceptadas o no).
  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")
}


// =============================================================================
//  TABLAS DE BETTER AUTH
//  Better Auth lee y escribe estas tablas por su cuenta. Sus nombres de campo
//  deben coincidir con los que espera la librería; no los renombres.
//  Fíjate en que su "id" no tiene @default: Better Auth genera el id él mismo.
// =============================================================================

// ========== SESIÓN ==========
// Una fila por cada sesión iniciada (cada navegador/dispositivo con la
// sesión abierta). Al cerrar sesión, la fila se borra.
model Session {
  id        String   @id

  // Texto aleatorio que se guarda (firmado) en la cookie del navegador.
  // En cada petición, Better Auth busca la sesión por este token.
  token     String   @unique

  // Cuándo caduca la sesión (por defecto, 7 días; se renueva al usarla).
  expiresAt DateTime

  // Datos informativos del dispositivo. Opcionales.
  ipAddress String?
  userAgent String?

  // Dueño de la sesión. Si se borra el usuario, se borran sus sesiones.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}


// ========== CUENTA (forma de entrar) ==========
// Una fila por cada método de acceso de un usuario.
//   - Correo y contraseña → providerId = "credential", y "password" guarda
//     el hash (scrypt) de la contraseña.
//   - Google (más adelante) → providerId = "google", con sus tokens.
model Account {
  id                    String    @id

  // Id del usuario DENTRO del proveedor. Para "credential" es el mismo
  // id del User; para Google será el id de Google.
  accountId             String

  // Quién autentica: "credential", "google", etc.
  providerId            String

  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tokens que entregan proveedores como Google. Vacíos con correo/contraseña.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  // Hash de la contraseña (solo en cuentas "credential"). Nunca la real.
  password              String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}


// ========== VERIFICACIÓN ==========
// Códigos temporales de un solo uso: confirmar correo, restablecer
// contraseña... Se borran al usarse o al caducar.
model Verification {
  id         String   @id

  // A qué o a quién pertenece el código. OJO: depende del uso. En el
  // restablecimiento de contraseña, identifier lleva el token
  // ("reset-password:<token>") y value el id del usuario. El enlace de
  // verificación de correo no deja fila (es un JWT firmado).
  identifier String

  // El valor asociado (en el restablecimiento, el id del usuario). No tiene
  // clave foránea: al borrar una cuenta se borran a mano (lib/profile.ts).
  value      String

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}


// ========== MATERIA ==========
model Subject {
  id     String @id @default(cuid())

  // Nombre de la materia, por ejemplo "Cálculo".
  name   String

  // CLAVE FORÁNEA: guarda el id del usuario dueño de esta materia.
  // Esta SÍ es una columna real en la tabla.
  userId String

  // Relación con User. Se lee así:
  //   "user" es de tipo User;
  //   fields: [userId]   → la columna de ESTA tabla que apunta al usuario...
  //   references: [id]   → ...apunta a la columna "id" de la tabla User.
  //   onDelete: Cascade  → si se borra el usuario, se borran sus materias.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Una materia tiene MUCHAS tareas (lado "lista" de la relación).
  tasks  Task[]

  // Y su banco de preguntas, con las que contraatacan sus jefes.
  questions Question[]

  // Veces que se invocó al escriba con apuntes de esta materia.
  agentInvocations AgentInvocation[]

  // Sin @@index: el índice lo pone la migración 20261019210000_materia_unica,
  // escrito a mano porque Prisma no sabe declarar índices de expresión:
  //   UNIQUE ("userId", lower(btrim(name)))  → "Subject_userId_name_ci_key"
  // Un usuario no puede tener dos materias con el mismo nombre sin contar
  // mayúsculas ni espacios de los extremos ("Cálculo" y " cálculo " chocan;
  // "Cálculo" y "Calculo", sin tilde, no). Como empieza por userId, también
  // hace rápido "todas las materias del usuario X", así que sustituye al
  // @@index([userId]) que había. Prisma no lo ve ni intenta borrarlo
  // (comprobado con migrate diff). Los choques se capturan en
  // app/materias/actions.ts (P2002 / 23505).
}


// ========== TAREA (JEFE) ==========
model Task {
  id          String     @id @default(cuid())

  // Nombre de la tarea/jefe, por ejemplo "Parcial de Física".
  name        String

  // Clave foránea hacia la materia a la que pertenece.
  subjectId   String
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Fecha de entrega. DateTime guarda fecha y hora.
  dueDate     DateTime

  // Dificultad: solo acepta EASY, MEDIUM o HARD (el enum de arriba).
  difficulty  Difficulty

  // Vida total del jefe: 100 por cada bloque de estudio que hace falta para
  // derrotarlo (EASY 200, MEDIUM 400, HARD 600). Las reglas están en lib/game.ts.
  maxHp       Int

  // Vida que le queda. Irá bajando con cada sesión de estudio.
  currentHp   Int

  // Estado del combate. Toda tarea nueva empieza como ALIVE.
  status      TaskStatus @default(ALIVE)

  // Qué criatura es el jefe: la clave del bestiario de lib/game.ts, que es
  // también el nombre de su ilustración (public/jefes/<clave>.webp). La elige
  // el servidor al invocar. Obligatoria desde la migración
  // 20261008204228_boss_key_obligatorio, que rellenó las que faltaban. Para leerla
  // usa SIEMPRE bossForTask(), que comprueba que sea de su dificultad.
  bossKey     String

  // Almas que dio la victoria (sin las del golpe final, que van en su
  // vigilia). La tira el servidor al vencer al jefe. null = sigue vivo, o cayó
  // antes de que existieran las almas (no hay almas retroactivas).
  victorySouls Int?

  // Cuándo pasó a FAILED: el momento en que la revisión de jefes vencidos
  // (lib/redemption.ts) registró la caída, no la medianoche de la entrega.
  // null = no ha caído (o cayó antes de que existiera esta columna).
  failedAt    DateTime?

  // Una tarea tiene MUCHAS sesiones de estudio.
  sessions    StudySession[]

  // Misiones de redención que provocó la caída de este jefe.
  redemptionMissions RedemptionMission[]

  // La oferta de bendiciones de su victoria (como mucho una).
  blessingOffer BlessingOffer?

  // Índice para buscar rápido las tareas de una materia.
  @@index([subjectId])
}


// ========== SESIÓN DE ESTUDIO (VIGILIA) ==========
// Una fila por vigilia: se crea al comenzarla, se cierra (completedAt) al
// asestar el golpe y se borra si se abandona.
model StudySession {
  id              String   @id @default(cuid())

  // Clave foránea hacia la tarea en la que se estudió.
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Dueño de la vigilia. Task no tiene userId, pero aquí hace falta: la base
  // garantiza "una sola vigilia abierta por usuario" con un índice único
  // parcial sobre esta columna (ver la migración 20261007210121_batalla; Prisma
  // no sabe escribirlo en este archivo).
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Momento en que empezó la sesión. Por defecto, "ahora".
  startedAt       DateTime @default(now())

  // Cuándo termina. Se fija al comenzar con la hora del servidor; el golpe
  // solo vale a partir de este momento.
  endsAt          DateTime

  // Cuándo se asestó el golpe. null = la vigilia sigue abierta.
  completedAt     DateTime?

  // Duración de la sesión en minutos.
  durationMinutes Int

  // Almas que dio el golpe de esta vigilia (1–100, al azar en el servidor).
  // null = sigue abierta, o se cumplió antes de que existieran las almas.
  soulsEarned     Int?

  // Preguntas contestadas en los contraataques de esta vigilia.
  questionAttempts QuestionAttempt[]

  // El contraataque que provocó el golpe de esta vigilia (o ninguno, si el
  // golpe derrotó al jefe o la vigilia sigue abierta).
  counterattack   Counterattack?

  // Índice para buscar rápido las sesiones de una tarea.
  @@index([taskId])
  // Y las de un usuario (lo usa también el borrado en cascada del usuario).
  @@index([userId])
}


// ========== MISIÓN DE REDENCIÓN ==========
// Al caer ante uno o más jefes, el usuario pierde las almas que llevaba dentro
// de su nivel, y esas almas quedan "en juego" en una misión: si la cumple a
// tiempo, vuelven. Una sola ACTIVE por usuario, garantizado por un índice
// único parcial (ver la migración 20261008222051_redencion; Prisma no sabe
// escribirlo en este archivo).
model RedemptionMission {
  id           String           @id @default(cuid())

  // Dueño de la misión.
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // El jefe que la provocó. Si cayeron varios a la vez, el primero por
  // fecha de entrega y nombre (los demás tienen el mismo Task.failedAt).
  // Su materia (Task.subjectId) es la de la prueba de redención: no hace
  // falta guardarla aparte.
  taskId       String
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Almas que se perdieron al caer y que vuelven si se cumple la misión.
  soulsAtStake Int

  // Vigilias cumplidas desde la caída. Las cuenta advanceRedemption().
  vigilsDone   Int              @default(0)

  // Cómo se cumple. Se fija al caer (lib/redemption.ts). Las misiones de
  // antes de la Fase 3 quedaron en LEGACY por el valor por defecto.
  rule         RedemptionRule   @default(LEGACY)

  // Intentos de la prueba ya empezados (solo TRIAL). Cada vigilia da uno:
  // los disponibles son vigilsDone − trialsUsed. Un CHECK de la migración
  // 20261018235832_fase3 impide que pase de vigilsDone o baje de 0.
  trialsUsed   Int              @default(0)

  status       RedemptionStatus @default(ACTIVE)

  // Momento de la caída: el mismo instante que Task.failedAt de los jefes
  // que cayeron en esa revisión.
  fellAt       DateTime

  // Hasta cuándo se puede cumplir: fellAt + REDEMPTION.hours.
  deadline     DateTime

  // Cuándo dejó de estar ACTIVE. Los avisos de "almas recuperadas" y "almas
  // desvanecidas" salen durante las 24 h siguientes a esta fecha.
  resolvedAt   DateTime?

  // Las pruebas de redención de esta misión.
  trials       RedemptionTrial[]

  @@index([userId])
  @@index([taskId])
}


// ========== PRUEBA DE REDENCIÓN ==========
// Un intento de la prueba de una misión TRIAL: 5 preguntas del banco de la
// materia del jefe caído; se aprueba con 4 (REDEMPTION.trial en lib/game.ts).
// Como el contraataque, todo el estado vive aquí, en el servidor, y el
// navegador solo manda "contesto la pregunta N con la opción X" (reglas y
// bloqueos en lib/redemption-trial.ts). No da ni quita almas: solo devuelve
// las de la misión al aprobar.
// La migración 20261018235832_fase3 añade a mano un índice único parcial:
// una sola prueba ABIERTA (finishedAt null) por misión. Prisma no sabe
// escribirlo aquí.
model RedemptionTrial {
  id           String            @id @default(cuid())

  // La misión de la que es intento. Si se borra la misión, se borra.
  missionId    String
  mission      RedemptionMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  // Dueño. Se repite (la misión ya lo tiene) para comprobarlo sin unir tablas.
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Las preguntas, con el MISMO formato que Counterattack.items
  // ({ ref, order }, validado con parseItems en lib/questions/counterattack.ts).
  items        Json

  // Contestadas (o esquivadas, o saltadas). La que toca es items[answered].
  answered     Int               @default(0)

  // Aciertos. Esquivar o una pregunta saltada (borrada) no cuentan.
  correctCount Int               @default(0)

  // ¿Aprobó? null = en curso (o abandonada porque la misión terminó).
  passed       Boolean?

  // Cuándo terminó: al contestar la última. null = en curso.
  finishedAt   DateTime?

  // Aciertos que hacen falta para aprobar, fijados al empezar: 4
  // (REDEMPTION.trial.passWith), o 3 con el Sello de redención, que se gasta
  // al empezarla (lib/redemption-trial.ts). Un CHECK de la migración fase4
  // lo deja entre 1 y 5.
  passWith     Int               @default(4)

  createdAt    DateTime          @default(now())

  @@index([missionId])
  @@index([userId])
}


// ========== PREGUNTA (BANCO DE PREGUNTAS) ==========
// Las preguntas de una materia, con las que sus jefes contraatacan. El combate
// las pide SOLO a través de preguntasParaContraataque() (lib/questions/provider.ts).
// La migración 20261011001244_banco_preguntas añade a mano tres CHECK que
// Prisma no gestiona (número de opciones según el tipo y rangos de
// correctIndex y QuestionAttempt.chosenIndex): no los busques aquí.
model Question {
  id           String         @id @default(cuid())

  // Materia a la que pertenece. Si se borra la materia, se borran sus preguntas.
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  type         QuestionType

  // MANUAL salvo que la cree el agente. Nunca sale del formulario.
  source       QuestionSource @default(MANUAL)

  // Enunciado: de 1 a 500 caracteres.
  prompt       String

  // String[] = array de textos de Postgres (text[]): las opciones, en orden.
  // 4 en opción múltiple y ["Verdadero", "Falso"] en verdadero o falso.
  options      String[]

  // Posición de la respuesta correcta dentro de options (empieza en 0).
  correctIndex Int

  // Por qué es la correcta. Opcional, hasta 1000 caracteres.
  explanation  String?

  // Tema ("Derivadas"): opcional, hasta 60 caracteres, normalizado con
  // normalizeTopic (lib/questions/validation.ts). Lo pone el escriba o el
  // formulario. Agrupa los "Puntos débiles" de la materia. El de una sellada
  // tampoco sale del servidor (daría una pista). Las de antes de la Fase 3
  // no tienen.
  topic        String?

  // SELLADA: nadie la ha visto todavía. Solo las del escriba nacen selladas;
  // se revela (false) en cuanto un jefe la lanza y se contesta o se esquiva
  // (responderPreguntaDe en lib/battle.ts). Mientras lo esté, ni su enunciado
  // ni sus opciones ni su respuesta salen del servidor, y no se puede editar,
  // solo borrar. Es una columna y no se deduce de los intentos porque editar
  // una pregunta borra sus intentos: deducido, editar una ya revelada la
  // volvería a sellar. Un CHECK de la migración 20261012010722_escriba impide una
  // MANUAL sellada.
  sealed       Boolean        @default(false)

  // REPASO (repetición espaciada, REVIEW en lib/game.ts). Van en la pregunta
  // y no en una tabla aparte porque cada pregunta es de un solo usuario.
  // reviewLevel: de 0 a 5 (5 = dominada). Un CHECK de la migración
  // 20261012183227_repaso impide salirse. Lo cambian SOLO responderPreguntaDe
  // (con nextReview) y editar una pregunta de forma que pasa a ser otra.
  reviewLevel  Int            @default(0)
  // Cuándo vuelve a tocar: un INSTANTE (las 00:00 de Bogotá, o el momento del
  // fallo), no un día a las 00:00 UTC como Task.dueDate, porque se compara
  // con la hora actual. null = nueva: nunca contestada (o editada desde
  // entonces), incluidas las selladas.
  reviewDueAt  DateTime?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Veces que ha salido en un contraataque.
  attempts     QuestionAttempt[]

  // Las que tocan de una materia, por fecha. Como empieza por subjectId,
  // sirve también para "todas las preguntas de la materia X" (y para el
  // borrado en cascada): el @@index([subjectId]) que había era redundante y
  // lo quitó 20261019210000_materia_unica.
  @@index([subjectId, reviewDueAt])
}


// ========== INTENTO (RESPUESTA A UNA PREGUNTA) ==========
// Una fila cada vez que una pregunta sale en un contraataque. La escribe el
// combate (Fase 2, paso 2); el banco solo la lee para las estadísticas.
model QuestionAttempt {
  id             String        @id @default(cuid())

  // Si se borra la pregunta, se borran sus intentos.
  questionId     String
  question       Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Vigilia en la que salió. Opcional, y SetNull: si se borra la vigilia
  // (abandonarla la borra), el intento se queda, sin vigilia.
  studySessionId String?
  studySession   StudySession? @relation(fields: [studySessionId], references: [id], onDelete: SetNull)

  // Opción elegida. null = la esquivó (no contestó).
  chosenIndex    Int?

  // ¿Acertó? Esquivar cuenta como fallo.
  correct        Boolean

  // Almas ganadas (positivo) o perdidas (negativo) con esta respuesta.
  soulsDelta     Int

  createdAt      DateTime      @default(now())

  // Los intentos de un usuario con una pregunta (estadísticas, preguntas que
  // vuelven) y todos los de una pregunta (borrado en cascada).
  @@index([userId, questionId])
  @@index([questionId])
}


// ========== CONTRAATAQUE ==========
// Después de un golpe que NO derrota al jefe, el jefe contraataca con 1, 2 o 3
// preguntas según su dificultad (COUNTERATTACK en lib/game.ts). Todo el estado vive aquí, en el servidor: qué preguntas salen, en
// qué orden se muestran sus opciones y por cuál va. El navegador solo envía
// "contesto la pregunta N con la opción X" (reglas en lib/game.ts y
// lib/battle.ts).
model Counterattack {
  id             String        @id @default(cuid())

  // La vigilia cuyo golpe lo provocó. @unique: UN contraataque por vigilia, así
  // que repetir el golpe (o la creación) no da preguntas ni almas de más.
  studySessionId String        @unique
  studySession   StudySession  @relation(fields: [studySessionId], references: [id], onDelete: Cascade)

  // Dueño. Se repite aquí (la vigilia ya lo tiene) para comprobarlo sin unir
  // tablas y para buscar rápido su contraataque sin terminar.
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Json = un valor JSON cualquiera (Postgres jsonb). Aquí, una lista con una
  // entrada por pregunta, en el orden en que salen:
  //   { "ref": "<id de Question>" | "generic:<clave>", "order": [2, 0, 3, 1] }
  // order es la permutación de las opciones: la opción que se MUESTRA en la
  // posición i es la opción order[i] de la pregunta. Como Json acepta
  // cualquier cosa, se valida SIEMPRE al leerlo (parseItems en
  // lib/questions/counterattack.ts).
  items          Json

  // Dificultad del jefe al crear el contraataque: decide si da brasa
  // (EMBER en lib/game.ts). null = se creó antes de que existiera esta
  // columna: sigue funcionando, pero no da brasa.
  bossDifficulty Difficulty?

  // Almas extra por cada acierto de este contraataque: 0, o las de la
  // Bendición de la lucidez, que se gasta al CREARLO (lib/battle.ts). Solo los
  // aciertos de verdad: una genérica contestada no cuenta.
  bonusPerCorrect Int          @default(0)

  // Preguntas ya contestadas (o esquivadas, o saltadas). La que toca es
  // items[answered].
  answered       Int           @default(0)

  // Aciertos (una genérica contestada cuenta como acierto; esquivar, nunca).
  correctCount   Int           @default(0)

  // Almas ganadas o perdidas en total, las que de verdad se aplicaron.
  soulsDelta     Int           @default(0)

  // Cuándo terminó: al contestar la última, o al empezar otra vigilia con
  // este sin terminar (las que faltaban no cuentan). null = en curso.
  finishedAt     DateTime?

  createdAt      DateTime      @default(now())

  @@index([userId])
}


// ========== INVOCACIÓN DEL ESCRIBA ==========
// Una fila cada vez que el usuario invoca al escriba para que escriba
// preguntas desde sus apuntes. Sirve para el límite diario (3 con éxito por
// día de Colombia, AGENT en lib/agent/rules.ts) y como historial.
// NO guarda ni los apuntes, ni el PDF, ni el nombre del archivo: de lo que el
// usuario envió solo queda inputKind. Las reglas y el flujo (reservar con
// PENDING, llamar a Gemini fuera de la transacción, guardar) están en
// lib/agent/invocation.ts.
model AgentInvocation {
  id               String                @id @default(cuid())

  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Materia en la que se guardaron (o se iban a guardar) las preguntas.
  subjectId        String
  subject          Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Se crea PENDING al reservar y pasa a OK o FAILED al terminar. Una PENDING
  // de hace más de 5 minutos cuenta como fallida (la petición murió a medias).
  status           AgentInvocationStatus @default(PENDING)

  inputKind        AgentInputKind

  // Preguntas que de verdad se guardaron (0 si no es OK).
  questionsCreated Int                   @default(0)

  createdAt        DateTime              @default(now())

  // Cuándo pasó a OK o FAILED. null = sigue PENDING.
  finishedAt       DateTime?

  // Las de un usuario desde una hora (el límite diario).
  @@index([userId, createdAt])
  // Las de una materia (borrado en cascada).
  @@index([subjectId])
}


// =============================================================================
//  FASE 4: RECOMPENSAS Y COMPAÑEROS
//  Las reglas viven en lib/game.ts (BLESSINGS, RELICS y sus funciones puras);
//  las transacciones, en lib/battle.ts, lib/redemption-trial.ts,
//  lib/rewards.ts y lib/friends.ts. Lo que Prisma no sabe escribir aquí
//  (CHECK, el índice único de la pareja) va a mano en la migración fase4.
//  Estas filas son del usuario: SOLO se modifican con su fila de User ya
//  bloqueada (orden de bloqueos en lib/locks.ts).
// =============================================================================

// ========== BENDICIÓN ACTIVA ==========
// Una bendición elegida que aún tiene usos. Cuando se gasta el último, la
// fila se BORRA (por eso basta un índice único por usuario y tipo: nunca hay
// dos iguales activas). Un CHECK impide usesLeft < 1.
model Blessing {
  id        String      @id @default(cuid())

  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  key       BlessingKey

  // Usos que le quedan (BLESSINGS[key].uses al elegirla).
  usesLeft  Int

  createdAt DateTime    @default(now())

  @@unique([userId, key])
}


// ========== OFERTA DE BENDICIONES ==========
// Al vencer a un jefe, el servidor fija hasta 3 bendiciones distintas para
// elegir una (rollBlessingOffer en lib/game.ts), en la MISMA transacción que
// la victoria. Una por jefe (taskId @unique). Elegir se valida en el servidor
// contra estas opciones (lib/rewards.ts). Sin elegir, sigue pendiente hasta
// expiresAt (7 días) y después caduca. CHECK: de 1 a 3 opciones; chosenKey
// una de ellas; chosenKey y chosenAt, los dos o ninguno.
model BlessingOffer {
  id         String        @id @default(cuid())

  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // El jefe vencido. Si se borra (con su materia o la cuenta), se va con él.
  taskId     String        @unique
  task       Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Las bendiciones ofrecidas, en el orden en que se muestran.
  options    BlessingKey[]

  // La elegida y cuándo. null = pendiente.
  chosenKey  BlessingKey?
  chosenAt   DateTime?

  createdAt  DateTime      @default(now())
  expiresAt  DateTime

  // Las pendientes de un usuario (la mazmorra y la tarjeta).
  @@index([userId])
}


// ========== RELIQUIA ==========
// Recompensa permanente y SOLO cosmética: da un título que se puede equipar
// (User.equippedRelic). key es la de RELICS en lib/game.ts ("boss:<jefe>" o
// "flame:<días>"). Una sola vez por usuario (índice único).
model Relic {
  id       String   @id @default(cuid())

  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  key      String

  earnedAt DateTime @default(now())

  @@unique([userId, key])
}


// ========== COMPAÑEROS ==========
// Una fila por pareja, sea cual sea el sentido: un índice único a mano sobre
// (LEAST(requesterId, addresseeId), GREATEST(...)) impide A→B y B→A a la vez,
// y un CHECK impide ser compañero de uno mismo.
//   PENDING: requester pidió, addressee aún no contesta.
//   ACCEPTED: compañeros. Quitar a un compañero BORRA la fila.
//   DECLINED: addressee rechazó. La fila se queda como LÁPIDA: quien la envió
//     no se entera (la ve como pendiente) y, si vuelve a enviar, recibe el
//     mensaje genérico sin notificar de nuevo. Si la cancela, deja de verla
//     (hiddenByRequester), pero la fila sigue. Solo quien rechazó puede
//     reabrirla, introduciendo el código del otro.
model Friendship {
  id                String           @id @default(cuid())

  requesterId       String
  requester         User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId       String
  addressee         User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status            FriendshipStatus @default(PENDING)

  // Solo en DECLINED: quien la envió la canceló y ya no la ve.
  hiddenByRequester Boolean          @default(false)

  createdAt         DateTime         @default(now())

  // Cuándo se aceptó o se rechazó.
  respondedAt       DateTime?

  @@index([requesterId])
  @@index([addresseeId])
}
