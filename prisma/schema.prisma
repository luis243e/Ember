// =============================================================================
//  schema.prisma: el "plano" de tu base de datos.
//  Aquí describes tus tablas (models), sus columnas y cómo se relacionan.
//  Prisma lee este archivo para:
//    1) crear/modificar las tablas reales en Postgres (migraciones), y
//    2) generar un cliente TypeScript con autocompletado para usarlas.
//  Los comentarios con "//" son ignorados por Prisma; son solo para ti.
// =============================================================================


// -----------------------------------------------------------------------------
//  GENERATOR: qué código genera Prisma a partir de este archivo.
// -----------------------------------------------------------------------------
generator client {
  // "prisma-client-js" genera el cliente clásico de JavaScript/TypeScript.
  // En tu código lo importarás así: import { PrismaClient } from "@prisma/client"
  provider = "prisma-client-js"
}


// -----------------------------------------------------------------------------
//  DATASOURCE: a qué base de datos se conecta Prisma.
// -----------------------------------------------------------------------------
datasource db {
  // Tipo de base de datos: PostgreSQL (la que usa Supabase).
  provider  = "postgresql"

  // URL principal (pooler, puerto 6543). env("...") significa:
  // "lee este valor del archivo .env", así la contraseña no queda en el código.
  url       = env("DATABASE_URL")

  // URL directa (puerto 5432). Prisma la usa SOLO para migraciones,
  // porque el pooler no soporta bien los cambios de estructura de tablas.
  directUrl = env("DIRECT_URL")
}


// -----------------------------------------------------------------------------
//  ENUMS: listas cerradas de valores permitidos.
//  Si una columna es de tipo enum, la base de datos rechaza cualquier otro valor.
// -----------------------------------------------------------------------------

// Dificultad de una tarea (jefe).
enum Difficulty {
  EASY    // fácil
  MEDIUM  // media
  HARD    // difícil
}

// Estado del combate contra una tarea (jefe).
enum TaskStatus {
  ALIVE     // la tarea sigue pendiente: el jefe sigue en pie
  DEFEATED  // la completaste a tiempo: derrotaste al jefe
  FAILED    // pasó la fecha de entrega sin terminarla: el jefe te derrotó
}


// -----------------------------------------------------------------------------
//  MODELOS: cada "model" se convierte en una TABLA de Postgres.
//  Cada línea dentro es una COLUMNA con la forma:  nombre  Tipo  @atributos
// -----------------------------------------------------------------------------

// ========== USUARIO (y su personaje) ==========
model User {
  // Identificador único de la fila.
  //   String     → se guarda como texto.
  //   @id        → esta columna es la clave primaria (identifica cada fila).
  //   @default(cuid()) → si no das un id, Prisma genera uno aleatorio único
  //                      (algo como "clx9k2...").
  id           String   @id @default(cuid())

  // @unique → la base de datos impide que dos usuarios tengan el mismo email.
  email        String   @unique

  // Nombre visible del usuario.
  name         String

  // ¿Confirmó su correo? Better Auth lo pone en true cuando el usuario
  // abre el enlace de verificación. Por ahora la verificación está
  // desactivada, así que se queda en false.
  emailVerified Boolean @default(false)

  // URL de la foto de perfil. El "?" significa OPCIONAL (puede ser null).
  // La rellenará Google cuando añadamos ese inicio de sesión.
  image        String?

  // OJO: aquí ya NO hay contraseña. Better Auth guarda el hash de la
  // contraseña en la tabla Account (columna "password"), porque una persona
  // puede tener varias formas de entrar (correo, Google...).

  // Fecha de creación. @default(now()) pone la fecha/hora actual al crear la fila.
  createdAt    DateTime @default(now())

  // Fecha de la última modificación. @updatedAt hace que Prisma la
  // actualice sola cada vez que cambia la fila.
  updatedAt    DateTime @updatedAt

  // --- Campos del personaje ---
  // Better Auth los conoce como "additionalFields" (ver lib/auth.ts), con
  // input: false para que nadie pueda fijarlos desde el navegador.
  // Nivel del personaje. Int = número entero. Todos empiezan en nivel 1.
  level        Int      @default(1)

  // "Almas": la experiencia acumulada. Empieza en 0.
  souls        Int      @default(0)

  // "Llama": la racha de días seguidos estudiando. Empieza en 0.
  flame        Int      @default(0)

  // --- Relación ---
  // Un usuario tiene MUCHAS materias. "Subject[]" (con corchetes) = lista.
  // OJO: esta línea NO crea una columna en la tabla; es un "atajo" para que
  // Prisma te deje pedir "el usuario con sus materias" en una sola consulta.
  subjects     Subject[]

  // Sesiones abiertas y formas de entrar del usuario (tablas de Better Auth).
  sessions     Session[]
  accounts     Account[]

  // Vigilias (sesiones de estudio) del usuario, de todos sus jefes.
  studySessions StudySession[]
}


// =============================================================================
//  TABLAS DE BETTER AUTH
//  Better Auth lee y escribe estas tablas por su cuenta. Sus nombres de campo
//  deben coincidir con los que espera la librería; no los renombres.
//  Fíjate en que su "id" no tiene @default: Better Auth genera el id él mismo.
// =============================================================================

// ========== SESIÓN ==========
// Una fila por cada sesión iniciada (cada navegador/dispositivo con la
// sesión abierta). Al cerrar sesión, la fila se borra.
model Session {
  id        String   @id

  // Texto aleatorio que se guarda (firmado) en la cookie del navegador.
  // En cada petición, Better Auth busca la sesión por este token.
  token     String   @unique

  // Cuándo caduca la sesión (por defecto, 7 días; se renueva al usarla).
  expiresAt DateTime

  // Datos informativos del dispositivo. Opcionales.
  ipAddress String?
  userAgent String?

  // Dueño de la sesión. Si se borra el usuario, se borran sus sesiones.
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}


// ========== CUENTA (forma de entrar) ==========
// Una fila por cada método de acceso de un usuario.
//   - Correo y contraseña → providerId = "credential", y "password" guarda
//     el hash (scrypt) de la contraseña.
//   - Google (más adelante) → providerId = "google", con sus tokens.
model Account {
  id                    String    @id

  // Id del usuario DENTRO del proveedor. Para "credential" es el mismo
  // id del User; para Google será el id de Google.
  accountId             String

  // Quién autentica: "credential", "google", etc.
  providerId            String

  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tokens que entregan proveedores como Google. Vacíos con correo/contraseña.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  // Hash de la contraseña (solo en cuentas "credential"). Nunca la real.
  password              String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}


// ========== VERIFICACIÓN ==========
// Códigos temporales de un solo uso: confirmar correo, restablecer
// contraseña... Se borran al usarse o al caducar.
model Verification {
  id         String   @id

  // A qué o a quién pertenece el código (por ejemplo, un correo).
  identifier String

  // El código o token en sí.
  value      String

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}


// ========== MATERIA ==========
model Subject {
  id     String @id @default(cuid())

  // Nombre de la materia, por ejemplo "Cálculo".
  name   String

  // CLAVE FORÁNEA: guarda el id del usuario dueño de esta materia.
  // Esta SÍ es una columna real en la tabla.
  userId String

  // Relación con User. Se lee así:
  //   "user" es de tipo User;
  //   fields: [userId]   → la columna de ESTA tabla que apunta al usuario...
  //   references: [id]   → ...apunta a la columna "id" de la tabla User.
  //   onDelete: Cascade  → si se borra el usuario, se borran sus materias.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Una materia tiene MUCHAS tareas (lado "lista" de la relación).
  tasks  Task[]

  // @@index (doble @ = afecta a toda la tabla) crea un índice sobre userId.
  // Un índice es como el índice de un libro: hace muy rápido buscar
  // "todas las materias del usuario X". Postgres no lo crea solo.
  @@index([userId])
}


// ========== TAREA (JEFE) ==========
model Task {
  id          String     @id @default(cuid())

  // Nombre de la tarea/jefe, por ejemplo "Parcial de Física".
  name        String

  // Clave foránea hacia la materia a la que pertenece.
  subjectId   String
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Fecha de entrega. DateTime guarda fecha y hora.
  dueDate     DateTime

  // Dificultad: solo acepta EASY, MEDIUM o HARD (el enum de arriba).
  difficulty  Difficulty

  // Vida total del jefe: 100 por cada bloque de estudio que hace falta para
  // derrotarlo (EASY 200, MEDIUM 400, HARD 600). Las reglas están en lib/game.ts.
  maxHp       Int

  // Vida que le queda. Irá bajando con cada sesión de estudio.
  currentHp   Int

  // Estado del combate. Toda tarea nueva empieza como ALIVE.
  status      TaskStatus @default(ALIVE)

  // Qué criatura es el jefe: la clave del bestiario de lib/game.ts, que es
  // también el nombre de su ilustración (public/jefes/<clave>.webp). La elige
  // el servidor al invocar. Es opcional porque el código anterior crea tareas
  // sin ella: para leerla usa SIEMPRE bossForTask(), que da uno determinista
  // si falta.
  bossKey     String?

  // Una tarea tiene MUCHAS sesiones de estudio.
  sessions    StudySession[]

  // Índice para buscar rápido las tareas de una materia.
  @@index([subjectId])
}


// ========== SESIÓN DE ESTUDIO (VIGILIA) ==========
// Una fila por vigilia: se crea al comenzarla, se cierra (completedAt) al
// asestar el golpe y se borra si se abandona.
model StudySession {
  id              String   @id @default(cuid())

  // Clave foránea hacia la tarea en la que se estudió.
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Dueño de la vigilia. Task no tiene userId, pero aquí hace falta: la base
  // garantiza "una sola vigilia abierta por usuario" con un índice único
  // parcial sobre esta columna (ver la migración 20261007210121_batalla; Prisma
  // no sabe escribirlo en este archivo).
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Momento en que empezó la sesión. Por defecto, "ahora".
  startedAt       DateTime @default(now())

  // Cuándo termina. Se fija al comenzar con la hora del servidor; el golpe
  // solo vale a partir de este momento.
  endsAt          DateTime

  // Cuándo se asestó el golpe. null = la vigilia sigue abierta.
  completedAt     DateTime?

  // Duración de la sesión en minutos.
  durationMinutes Int

  // Índice para buscar rápido las sesiones de una tarea.
  @@index([taskId])
  // Y las de un usuario (lo usa también el borrado en cascada del usuario).
  @@index([userId])
}
