# Plantilla del .env de DESARROLLO. Cópiala como .env (cp .env.example .env)
# y rellena BETTER_AUTH_SECRET. Nunca pongas aquí valores de producción:
# esos solo los tiene Vercel (y se consultan en Supabase -> Connect).

# Postgres de Docker (docker-compose.yml). No son secretos reales.
POSTGRES_USER=ember
POSTGRES_PASSWORD=ember_dev
POSTGRES_DB=ember

# Prisma: las dos al Postgres local (puerto 5433 del equipo).
DATABASE_URL=postgresql://ember:ember_dev@localhost:5433/ember
DIRECT_URL=postgresql://ember:ember_dev@localhost:5433/ember

# Better Auth: genera uno propio con  openssl rand -base64 32
# (distinto al de producción).
BETTER_AUTH_SECRET=
# Better Auth: URL base de la app. Los enlaces de los correos salen de aquí.
BETTER_AUTH_URL=http://localhost:3000

# Correos (lib/email.ts): Gmail por SMTP. GMAIL_USER es la dirección
# completa; GMAIL_APP_PASSWORD, una contraseña de aplicación de Google
# (16 letras, sin espacios), nunca la de la cuenta. Opcionales en desarrollo:
# vacías, el correo (con el enlace) se escribe en la consola de `npm run dev`.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opcional: acorta la vigilia a estos segundos para probar la batalla sin
# esperar 25 minutos (ver lib/game.ts). Vacío o sin la línea = 25 minutos.
EMBER_TEST_VIGIL_SECONDS=

# El escriba (lib/agent/gemini.ts): genera preguntas con Google Gemini desde
# los apuntes. GEMINI_API_KEY es tu clave de Google AI Studio (secreta: nunca
# en el código ni en el navegador) y GEMINI_MODEL el nombre del modelo. Sin
# ellas, la tarjeta dice "El escriba no está disponible".
GEMINI_API_KEY=
GEMINI_MODEL=

# Opcional, SOLO en local: con 1, el escriba devuelve preguntas de ejemplo sin
# llamar a Google (las pruebas no gastan cuota). En producción se ignora
# siempre. Nunca se configura en Vercel.
EMBER_FAKE_AGENT=
