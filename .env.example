# Plantilla del .env de DESARROLLO. Cópiala como .env (cp .env.example .env)
# y rellena BETTER_AUTH_SECRET. Nunca pongas aquí valores de producción:
# esos solo los tiene Vercel (y se consultan en Supabase -> Connect).

# Postgres de Docker (docker-compose.yml). No son secretos reales.
POSTGRES_USER=ember
POSTGRES_PASSWORD=ember_dev
POSTGRES_DB=ember

# Prisma: las dos al Postgres local (puerto 5433 del equipo).
DATABASE_URL=postgresql://ember:ember_dev@localhost:5433/ember
DIRECT_URL=postgresql://ember:ember_dev@localhost:5433/ember

# Better Auth: genera uno propio con  openssl rand -base64 32
# (distinto al de producción).
BETTER_AUTH_SECRET=
# Better Auth: URL base de la app
BETTER_AUTH_URL=http://localhost:3000

# Opcional: acorta la vigilia a estos segundos para probar la batalla sin
# esperar 25 minutos (ver lib/game.ts). Vacío o sin la línea = 25 minutos.
EMBER_TEST_VIGIL_SECONDS=
